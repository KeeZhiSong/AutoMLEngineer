+def _max_user_length(user_id: np.ndarray) -> int:
+    """curriculum-learning: full sequence length is the longest train user list."""
+    if len(user_id) == 0:
+        return 0
+    _, _, lengths = group_segments(user_id)
+    return int(lengths.max()) if len(lengths) else 0
