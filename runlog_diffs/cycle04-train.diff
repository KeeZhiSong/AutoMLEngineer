+def _positive_rate_weights(y: np.ndarray) -> tuple[np.ndarray, float, float, float]:
+    """sample-weighting: train-only class weights from positive-rate discrepancy.
+
+    Positives receive weight proportional to neg_rate / pos_rate, so when
+    positives are overrepresented their per-row contribution is reduced. We then
+    normalise the weights to mean 1 to keep the learning-rate scale close to the
+    unweighted baseline.
+    """
+    label = y > 0.5
+    pos_rate = float(np.mean(label)) if len(label) else 0.0
+    eps = 1e-6
+
+    if pos_rate <= eps or pos_rate >= 1.0 - eps:
+        weights = np.ones(len(y), dtype=np.float32)
+        return weights, pos_rate, 1.0, 1.0
+
+    neg_rate = 1.0 - pos_rate
+    raw_pos_w = neg_rate / pos_rate
+    raw_neg_w = 1.0
+    mean_w = pos_rate * raw_pos_w + neg_rate * raw_neg_w
+
+    pos_w = raw_pos_w / mean_w
+    neg_w = raw_neg_w / mean_w
+    weights = np.where(label, pos_w, neg_w).astype(np.float32)
+    return weights, pos_rate, float(pos_w), float(neg_w)
+
