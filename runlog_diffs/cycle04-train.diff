+def _weighted_pointwise_logloss(model: FM, X: np.ndarray, y: np.ndarray,
+                                sample_weight: np.ndarray) -> tuple[np.ndarray, float]:
+    """sample-weighting: pointwise logloss with per-row training weights."""
+    z, _, _ = model.logits(X)
+    p = sigmoid(z)
+    w = sample_weight.astype(np.float32, copy=False)
+    ce = -(y * np.log(p + 1e-9) + (1 - y) * np.log(1 - p + 1e-9))
+    dz = (((p - y) * w) / len(y)).astype(np.float32)
+    loss = float(np.mean(w * ce))
     return dz, loss
 
 
