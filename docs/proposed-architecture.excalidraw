      "id": "s4_frozen_h",
      "x": 84,
      "y": 1348,
      "width": 840,
      "height": 26,
      "text": "\ud83d\udd12 FROZEN \u2014 agent cannot edit",
      "originalText": "\ud83d\udd12 FROZEN \u2014 agent cannot edit",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
